{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:atlas-reactorum:reviewed-profiles:2.1.0",
  "title": "Atlas Reactorum original and reviewed profiles 2.1.0",
  "description": "Complete original/current catalogue relationships. Source-byte bindings, ordered identity, explicit revisions and scientific evidence relationships require owning semantic admission. Author review does not establish independent acceptance or publisher redistribution rights.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_count",
    "metadata_license",
    "source_rights",
    "inputs",
    "original_profiles",
    "author_reviews",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "atlas-reviewed-profiles-2.1.0"
    },
    "record_count": {
      "type": "integer",
      "minimum": 1
    },
    "metadata_license": {
      "const": "AGPL-3.0-or-later"
    },
    "source_rights": {
      "const": "catalogue-only; original not redistributed"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "taxonomy_sha256",
        "citations_sha256",
        "audit_sha256",
        "original_profiles_sha256",
        "author_reviews_sha256"
      ],
      "properties": {
        "taxonomy_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "citations_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "audit_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "original_profiles_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "author_reviews_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "original_profiles": {
      "$ref": "urn:atlas-reactorum:evidence-profiles:1.0.0"
    },
    "author_reviews": {
      "$ref": "urn:atlas-reactorum:author-review:1.1.0"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "urn:atlas-reactorum:evidence-profiles:1.0.0#/properties/records/items/properties/taxonomy_record"
      }
    }
  }
}
