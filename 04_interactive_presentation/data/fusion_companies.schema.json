{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fusion company and programme evidence-screening catalog",
  "description": "Dataset document. The record array is wrapped in an object because the Tier-0 scaffold profile requires an object at the top level of every repository JSON file.",
  "type": "object",
  "required": [
    "schema_version",
    "record_count",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "country",
          "approach",
          "status",
          "evidence",
          "company_claim",
          "independent_evidence",
          "source_url"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "approach": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "enum": [
              "A",
              "A/B",
              "B",
              "B/C",
              "C",
              "C-H",
              "D",
              "unassessed"
            ]
          },
          "company_claim": {
            "type": "string"
          },
          "independent_evidence": {
            "type": "string"
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "source_checked": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  }
}
