{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reactor Atlas facility record set",
  "description": "Dataset document. The record array is wrapped in an object because the Tier-0 scaffold profile requires an object at the top level of every repository JSON file.",
  "type": "object",
  "required": [
    "schema_version",
    "record_count",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "1.2.0",
        "1.3.0"
      ]
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "country",
          "lat",
          "lon",
          "domain",
          "type",
          "status",
          "evidence",
          "completeness",
          "source_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:._-]+$"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "domain": {
            "enum": [
              "fission",
              "fusion",
              "chemical",
              "hybrid"
            ]
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "completeness": {
            "enum": [
              "verified-location",
              "context-only",
              "partial",
              "unverified"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "source_checked": {
            "type": "string",
            "format": "date"
          },
          "purpose": {
            "type": "string"
          },
          "fuel_or_feed": {
            "type": "string",
            "description": "Published feedstock or publisher whole-plant fuel classification; inspect field_observations.basis."
          },
          "field_observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target_id",
                "target_dataset",
                "target_sha256",
                "field",
                "value",
                "basis",
                "source_record_id",
                "source_field",
                "source_artifact",
                "source_sha256",
                "source_url",
                "checked",
                "license"
              ],
              "properties": {
                "target_id": {
                  "type": "string",
                  "minLength": 1
                },
                "target_dataset": {
                  "type": "string",
                  "minLength": 1
                },
                "target_sha256": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "purpose",
                    "fuel_or_feed"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "published-end-use",
                    "published-feedstock",
                    "fuel-classification",
                    "primary-fuel-classification",
                    "secondary-fuel-classification"
                  ]
                },
                "source_record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_field": {
                  "type": "string",
                  "minLength": 1
                },
                "source_artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "source_sha256": {
                  "type": "string",
                  "minLength": 1
                },
                "source_url": {
                  "type": "string",
                  "minLength": 1
                },
                "checked": {
                  "type": "string",
                  "minLength": 1
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "research_field_origins": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "field",
                "value",
                "source_dataset",
                "source_sha256",
                "source_url",
                "source_role",
                "source_capture_date",
                "license",
                "scope",
                "selection"
              ],
              "properties": {
                "field": {
                  "type": "string",
                  "enum": [
                    "operator",
                    "purpose",
                    "first_criticality"
                  ]
                },
                "value": {
                  "type": "string"
                },
                "source_dataset": {
                  "type": "string"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                },
                "source_url": {
                  "type": "string"
                },
                "source_role": {
                  "type": "string"
                },
                "source_capture_date": {
                  "type": "string"
                },
                "license": {
                  "type": "string"
                },
                "scope": {
                  "type": "string"
                },
                "selection": {
                  "type": "string",
                  "enum": [
                    "selected",
                    "superseded"
                  ]
                }
              }
            },
            "description": "Original accepted research cells and their per-field source precedence; capture date is not publication or event date."
          },
          "research_primary_assertions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "stable_id",
                "field",
                "value",
                "selection",
                "source_id",
                "source_title",
                "source_url",
                "source_sha256",
                "source_class",
                "source_document_date",
                "source_capture_date",
                "locator",
                "scope",
                "rights",
                "date_precision",
                "assertion_basis",
                "related_evidence"
              ],
              "properties": {
                "stable_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$",
                  "minLength": 1
                },
                "field": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$",
                  "enum": [
                    "operator",
                    "purpose",
                    "first_criticality"
                  ]
                },
                "value": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "selection": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$",
                  "enum": [
                    "selected",
                    "held",
                    "unknown",
                    "not_applicable",
                    "never_critical",
                    "planned",
                    "composite"
                  ]
                },
                "source_id": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "source_title": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "source_url": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "source_sha256": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "source_class": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "source_document_date": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "source_capture_date": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "locator": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "scope": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$",
                  "minLength": 1
                },
                "rights": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                },
                "date_precision": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$",
                  "enum": [
                    "",
                    "year",
                    "month",
                    "day"
                  ]
                },
                "assertion_basis": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$",
                  "minLength": 1
                },
                "related_evidence": {
                  "type": "string",
                  "pattern": "^[^\\u0000-\\u001f]*$"
                }
              }
            },
            "description": "Complete primary source decisions for originally blank cells. Held and no-fill decisions remain evidence without supplying scalar values; source dates are distinct from event precision."
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "1.2.0"
          }
        }
      },
      "then": {
        "properties": {
          "records": {
            "items": {
              "properties": {
                "research_primary_assertions": false
              }
            }
          }
        }
      }
    }
  ]
}
