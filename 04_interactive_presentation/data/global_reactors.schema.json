{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reactor Atlas facility record set",
  "description": "Dataset document. The record array is wrapped in an object because the Tier-0 scaffold profile requires an object at the top level of every repository JSON file.",
  "type": "object",
  "required": [
    "schema_version",
    "record_count",
    "records"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.1.0"
    },
    "record_count": {
      "type": "integer",
      "minimum": 0
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "country",
          "lat",
          "lon",
          "domain",
          "type",
          "status",
          "evidence",
          "completeness",
          "source_url"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9:._-]+$"
          },
          "name": {
            "type": "string"
          },
          "country": {
            "type": "string"
          },
          "lat": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -90,
            "maximum": 90
          },
          "lon": {
            "type": [
              "number",
              "null"
            ],
            "minimum": -180,
            "maximum": 180
          },
          "domain": {
            "enum": [
              "fission",
              "fusion",
              "chemical",
              "hybrid"
            ]
          },
          "type": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          },
          "completeness": {
            "enum": [
              "verified-location",
              "context-only",
              "partial",
              "unverified"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "source_checked": {
            "type": "string",
            "format": "date"
          },
          "purpose": {
            "type": "string"
          },
          "fuel_or_feed": {
            "type": "string",
            "description": "Published feedstock or publisher whole-plant fuel classification; inspect field_observations.basis."
          },
          "field_observations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "target_id",
                "target_dataset",
                "target_sha256",
                "field",
                "value",
                "basis",
                "source_record_id",
                "source_field",
                "source_artifact",
                "source_sha256",
                "source_url",
                "checked",
                "license"
              ],
              "properties": {
                "target_id": {
                  "type": "string",
                  "minLength": 1
                },
                "target_dataset": {
                  "type": "string",
                  "minLength": 1
                },
                "target_sha256": {
                  "type": "string",
                  "minLength": 1
                },
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "purpose",
                    "fuel_or_feed"
                  ]
                },
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "basis": {
                  "type": "string",
                  "minLength": 1,
                  "enum": [
                    "published-end-use",
                    "published-feedstock",
                    "fuel-classification",
                    "primary-fuel-classification",
                    "secondary-fuel-classification"
                  ]
                },
                "source_record_id": {
                  "type": "string",
                  "minLength": 1
                },
                "source_field": {
                  "type": "string",
                  "minLength": 1
                },
                "source_artifact": {
                  "type": "string",
                  "minLength": 1
                },
                "source_sha256": {
                  "type": "string",
                  "minLength": 1
                },
                "source_url": {
                  "type": "string",
                  "minLength": 1
                },
                "checked": {
                  "type": "string",
                  "minLength": 1
                },
                "license": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  }
}
