{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/anulum/reactor-research-map/reactor-map.schema.json",
  "title": "Evidence-linked global reactor facility record",
  "type": "object",
  "required": [
    "id",
    "name",
    "domain",
    "reactor_type",
    "record_kind",
    "status",
    "evidence_maturity",
    "location",
    "sources",
    "last_verified"
  ],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "record_kind": {
      "enum": ["facility", "reactor_unit", "experimental_device", "project", "claim", "taxonomy_only"]
    },
    "domain": {
      "enum": ["nuclear_fission", "plasma_fusion", "chemical", "biochemical", "hybrid", "emerging"]
    },
    "reactor_type": { "type": "string", "minLength": 1 },
    "subtypes": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "purpose": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
    "status": {
      "enum": ["operational", "under_construction", "planned", "suspended", "shutdown", "decommissioning", "decommissioned", "cancelled", "historical", "claimed", "unknown"]
    },
    "evidence_maturity": {
      "enum": ["established", "demonstrated_component", "active_research", "contested", "null_or_critical", "speculative", "self_reported", "unknown"]
    },
    "location": {
      "type": "object",
      "required": ["country_code", "precision"],
      "properties": {
        "site": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "region": { "type": ["string", "null"] },
        "country": { "type": ["string", "null"] },
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$" },
        "latitude": { "type": ["number", "null"], "minimum": -90, "maximum": 90 },
        "longitude": { "type": ["number", "null"], "minimum": -180, "maximum": 180 },
        "precision": { "enum": ["exact", "site", "city", "region", "country", "withheld", "unknown"] },
        "coordinate_source": { "type": ["string", "null"], "format": "uri" }
      },
      "additionalProperties": false
    },
    "organizations": {
      "type": "object",
      "properties": {
        "owner": { "type": ["string", "null"] },
        "operator": { "type": ["string", "null"] },
        "designer": { "type": ["string", "null"] },
        "regulator": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "technical": {
      "type": "object",
      "properties": {
        "fuel_or_feed": { "type": ["string", "null"] },
        "coolant_or_medium": { "type": ["string", "null"] },
        "moderator": { "type": ["string", "null"] },
        "confinement_or_flow": { "type": ["string", "null"] },
        "thermal_power_mw": { "type": ["number", "null"], "minimum": 0 },
        "electric_power_mw": { "type": ["number", "null"], "minimum": 0 },
        "capacity_note": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    },
    "dates": {
      "type": "object",
      "additionalProperties": { "type": ["string", "null"] }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["text", "claimant", "assessment"],
        "properties": {
          "text": { "type": "string" },
          "claimant": { "type": "string" },
          "assessment": { "type": "string" },
          "source_url": { "type": "string", "format": "uri" }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["url", "publisher", "retrieved", "source_role"],
        "properties": {
          "url": { "type": "string", "format": "uri" },
          "publisher": { "type": "string" },
          "title": { "type": ["string", "null"] },
          "retrieved": { "type": "string", "format": "date" },
          "source_role": { "enum": ["registry", "regulator", "operator", "primary_research", "independent_review", "news", "claim"] },
          "licence": { "type": ["string", "null"] }
        }
      }
    },
    "verification_notes": { "type": ["string", "null"] },
    "last_verified": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}
